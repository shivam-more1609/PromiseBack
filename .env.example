# PromiseBack Environment Configuration Template

# Server-Side Administrator Credentials (Hackathon Demo)
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here

# Server-Side API Key for Mutation Endpoint Protection
PROMISEBACK_API_KEY=your_secure_mutation_api_key_here
SESSION_SECRET=your_32_byte_session_hmac_secret_here

# PayPal Sandbox Credentials (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
PAYPAL_SANDBOX_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_SANDBOX_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_SANDBOX_WEBHOOK_ID=your_sandbox_webhook_id_here

# Gemini Model Configuration (SERVER-SIDE ONLY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Base App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
